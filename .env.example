# Server Configuration
PORT=3000
NODE_ENV=development

# MCP Authentication
# Genera un token sicuro con: openssl rand -hex 32
MCP_BEARER_TOKEN=your_secure_mcp_bearer_token_here

# Database Configuration (PostgreSQL/Supabase)
# Opzione 1: DATABASE_URL (connessione diretta PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/mcp_tickets?schema=public

# Opzione 2: Supabase (commenta DATABASE_URL se usi Supabase)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# OpenAI Configuration (per embedding knowledge base)
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector Search Configuration
VECTOR_SIMILARITY_THRESHOLD=0.7
VECTOR_MAX_RESULTS=5

# Jina AI Configuration (opzionale, per ricerca documentazione live)
# Aumenta i limiti di frequenza e velocizza la ricerca
JINA_API_KEY=your_jina_api_key_here