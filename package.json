{
  "name": "mcp-ticket-server",
  "version": "1.0.0",
  "description": "MCP Server for Ticket Management with Turso/libSQL",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "watch": "tsc -w",
    "lint": "eslint src --ext .ts",
    "db:init": "ts-node src/db/init.ts"
  },
  "keywords": [
