# ============================================
# MCP Ticket Server - Variabili d'ambiente Docker
# ============================================
# Copia questo file in .env e compila i valori

# --- Server ---
PORT=3000
NODE_ENV=production

# --- MCP Authentication ---
MCP_BEARER_TOKEN=genera-un-token-sicuro-openssl-rand-hex-32

# --- Database Turso ---
DATABASE_URL=libsql://tuo-database-turso
TURSO_AUTH_TOKEN=il-tuo-auth-token

# --- OpenAI / Embedding ---
OPENAI_API_KEY=sk-or-v1-xxx
OPENAI_EMBEDDING_MODEL=google/gemini-2.5-flash

# --- Vector Search ---
VECTOR_SIMILARITY_THRESHOLD=0.7
VECTOR_MAX_RESULTS=5

# --- Jina AI (ricerca documentazione live) ---
JINA_API_KEY=jina_xxx

# --- ngrok (obbligatorio per esporre il server) ---
NGROK_AUTHTOKEN=il-tuo-authtoken-ngrok
